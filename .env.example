# Copy to .env and fill in (never commit .env; never paste keys into chat)

# --- LLM (picks the song + writes the prescription) ----------------------
# Free options:
#   groq       -> key from https://console.groq.com/keys      (default model openai/gpt-oss-120b; no training on your data)
#   gemini     -> key from https://aistudio.google.com/apikey (default model gemini-3.5-flash; free tier may be used by Google)
#   openrouter -> key from https://openrouter.ai/keys         (set LLM_MODEL to a ":free" model)
#   claude-cli -> your Claude Pro/Max subscription via Claude Code (run `claude` once to log in)
#   ollama     -> local, no key
# Paid: anthropic | openai
LLM_PROVIDER=groq
# Optional: override the provider's default model
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Spotify (verifies songs exist, links + player) ----------------------
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
